</div>
<table><thead><tr><th>Sensor</th><th>Status</th><th>Raw P</th><th>Raw R</th>
<th id='fph'>Filtered P</th><th id='frh'>Filtered R</th>
<th>Diff P</th><th>Diff R</th></tr></thead><tbody>
<tr><td class='sn'>Palm</td>  <td id='ss0'>-</td><td class='rv' id='rp0'>-</td><td class='rv' id='rr0'>-</td><td class='fv' id='fp0'>-</td><td class='fv' id='fr0'>-</td><td id='dp0' class='dz'>-</td><td id='dr0' class='dz'>-</td></tr>
<tr><td class='sn'>Thumb</td><td id='ss1'>-</td><td class='rv' id='rp1'>-</td><td class='rv' id='rr1'>-</td><td class='fv' id='fp1'>-</td><td class='fv' id='fr1'>-</td><td id='dp1' class='dz'>-</td><td id='dr1' class='dz'>-</td></tr>
<tr><td class='sn'>Index</td> <td id='ss2'>-</td><td class='rv' id='rp2'>-</td><td class='rv' id='rr2'>-</td><td class='fv' id='fp2'>-</td><td class='fv' id='fr2'>-</td><td id='dp2' class='dz'>-</td><td id='dr2' class='dz'>-</td></tr>
<tr><td class='sn'>Middle</td>   <td id='ss3'>-</td><td class='rv' id='rp3'>-</td><td class='rv' id='rr3'>-</td><td class='fv' id='fp3'>-</td><td class='fv' id='fr3'>-</td><td id='dp3' class='dz'>-</td><td id='dr3' class='dz'>-</td></tr>
<tr><td class='sn'>Ring</td><td id='ss4'>-</td><td class='rv' id='rp4'>-</td><td class='rv' id='rr4'>-</td><td class='fv' id='fp4'>-</td><td class='fv' id='fr4'>-</td><td id='dp4' class='dz'>-</td><td id='dr4' class='dz'>-</td></tr>
<tr><td class='sn'>Little</td> <td id='ss5'>-</td><td class='rv' id='rp5'>-</td><td class='rv' id='rr5'>-</td><td class='fv' id='fp5'>-</td><td class='fv' id='fr5'>-</td><td id='dp5' class='dz'>-</td><td id='dr5' class='dz'>-</td></tr>
</tbody></table></div>

