/*
 * HandGPT v4 — ESP32-S3 Version (Instant Direct AP Mode)
 * Pins:
 *   SDA -> GPIO 18
 *   SCL -> GPIO 9
 * Multiplexer: 0x70 (TCA9548A / PCA9548A)
 * Channels:
 *   CH0 -> Palm      CH1 -> Middle
 *   CH2 -> Thumb     CH3 -> Ring
 *   CH4 -> Little    CH5 -> Index
 *
 * AP Mode Info:
 *   SSID:     HandGPT-v4
 *   PASS:     12345678
 *   URL:      http://192.168.4.1
 */

#include <Arduino.h>
#include <Wire.h>
#include <WiFi.h>
#include <WebServer.h>
#include <WebSocketsServer.h>
#include <LittleFS.h>
#include <SPIFFS.h>
#include <math.h>

// ── Access Point Configuration ────────────────────────────────────
#define AP_SSID "HandGPT-v4"
#define AP_PASS "12345678"

// ── I2C Pins for ESP32-S3 ─────────────────────────────────────────
#define I2C_SDA  18
#define I2C_SCL  19
#define PCA_ADDR 0x70
#define MPU_ADDR 0x68

// Channels: CH0–CH5
const uint8_t CH[6] = { 0, 1, 2, 3, 4, 5 };
const char*   NM[6] = { "Palm", "Thumb", "Index", "Middle", "Ring", "Little" };

// ---- FILTERS ----
struct Kalman {
  float q=0.001f,r=0.05f,p=1.0f,x=0; bool init=false;
  float update(float z){ if(!init){x=z;init=true;return z;} p+=q;float k=p/(p+r);x+=k*(z-x);p*=(1-k);return x; }
  void reset(){ init=false; p=1.0f; }
};
#define MA_WIN 10
struct MovAvg {
  float buf[MA_WIN]={0}; int idx=0,cnt=0;
  float update(float z){ buf[idx]=z;idx=(idx+1)%MA_WIN;if(cnt<MA_WIN)cnt++;float s=0;for(int i=0;i<cnt;i++)s+=buf[i];return s/cnt; }
  void reset(){ idx=0;cnt=0; }
};
struct Comp {
  float x=0; bool init=false;
  float update(float z){ if(!init){x=z;init=true;return z;} x=0.85f*x+0.15f*z;return x; }
  void reset(){ init=false; }
};

Kalman kP[6],kR[6];
MovAvg mP[6],mR[6];
Comp   cP[6],cR[6];

float rawP[6],rawR[6],filP[6],filR[6];
bool  sensorOK[6] = {false,false,false,false,false,false};
int   activeFilter = 1;

// ================================================================
//  GESTURE STORAGE — KNN multi-vector
// ================================================================
#define MAX_GESTURES   30
#define MAX_VECS        5   // recordings per label
#define KNN_K           3   // neighbours to vote
#define MAX_SAMPLES   500
// Optional gyro support – enable by defining INCLUDE_GYRO = 1
#define INCLUDE_GYRO 0
#define FEAT_DIM 12
#if INCLUDE_GYRO
  #undef FEAT_DIM
  #define FEAT_DIM 24  // pitch, roll, gyroX, gyroY per sensor
#endif

// Raw and filtered gyro arrays (only used when INCLUDE_GYRO == 1)
#if INCLUDE_GYRO
float rawG[6], filG[6]; // gyro Y axis (for simplicity we use only one gyro axis)
#endif

#define SOFTMAX_SIGMA  20.0f
#define DS_FILE        "/hgpt.bin"

struct Gesture {
  char  label[32];
  float vecs[MAX_VECS][FEAT_DIM];
  int   vecCount;
  int   lastSamples;
  bool  used;
};

Gesture gestures[MAX_GESTURES];
int     gestureCount = 0;

static float recBuf[MAX_SAMPLES][FEAT_DIM];
int   recCount  = 0;
bool  recActive = false;
char  recLabel[32] = "";

// Majority vote smoothing
#define VOTE_WIN 3
char  voteHist[VOTE_WIN][32];
int   voteIdx = 0;

// Boot status flags
bool  pcaFound    = false;
int   mpuFoundCnt = 0;
bool  wifiOK      = false;
char  ipStr[20]   = "192.168.4.1";

WebServer        http(80);
WebSocketsServer ws(81);

// ================================================================
//  FILESYSTEM (LittleFS Primary with SPIFFS Fallback)
// ================================================================
bool fsOK = false;
bool isLittleFS = false;

// ------------------------------------------------
//  Wi‑Fi AP helper – retries and error reporting
// ------------------------------------------------
bool startAP(){
  const int maxAttempts = 3;
  for(int attempt=1; attempt<=maxAttempts; ++attempt){
    if(WiFi.softAP(AP_SSID, AP_PASS)){
      IPAddress ip = WiFi.softAPIP();
      snprintf(ipStr, sizeof(ipStr), "%d.%d.%d.%d", ip[0],ip[1],ip[2],ip[3]);
      wifiOK = true;
      Serial.printf("[AP] Started (attempt %d) – IP %s\n", attempt, ipStr);
      return true;
    }
    Serial.printf("[AP] softAP failed (attempt %d) – retrying...\n", attempt);
    delay(500);
  }
  // All attempts failed – report to UI
  wifiOK = false;
  if(ws.connectedClients()>0) ws.broadcastTXT("{\"type\":\"info\",\"msg\":\"AP start failed – device in AP‑only mode unavailable\"}");
  return false;
}

void initFS(){
  if(LittleFS.begin(true)){
    fsOK = true;
    isLittleFS = true;
    Serial.println("[FS]     LittleFS mounted successfully");
  } else if(SPIFFS.begin(true)){
    fsOK = true;
    isLittleFS = false;
    Serial.println("[FS]     SPIFFS mounted successfully");
  } else {
    Serial.println("[FS]     ERROR: Flash filesystem mount failed!");
  }
}

void saveDataset(){
  if(!fsOK){ Serial.println("[FS] Save FAIL: No filesystem"); return; }
  File f = isLittleFS ? LittleFS.open(DS_FILE,"w") : SPIFFS.open(DS_FILE,"w");
  if(!f){ Serial.println("[FS] Save FAIL: Open file failed"); return; }
  f.write((uint8_t*)&gestureCount, sizeof(gestureCount));
  for(int i=0;i<gestureCount;i++) f.write((uint8_t*)&gestures[i], sizeof(Gesture));
  f.close();
  Serial.printf("[FS] Saved %d gestures to flash\n", gestureCount);
}

void loadDataset(){
  if(!fsOK) return;
  bool exists = isLittleFS ? LittleFS.exists(DS_FILE) : SPIFFS.exists(DS_FILE);
  if(!exists){ Serial.println("[FS] No dataset file found"); return; }
  File f = isLittleFS ? LittleFS.open(DS_FILE,"r") : SPIFFS.open(DS_FILE,"r");
  if(!f){ Serial.println("[FS] Load FAIL: Open file failed"); return; }
  int gc=0;
  f.read((uint8_t*)&gc, sizeof(gc));
  if(gc<0||gc>MAX_GESTURES){ f.close(); Serial.println("[FS] Invalid dataset file"); return; }
  gestureCount=gc;
  for(int i=0;i<gestureCount;i++) f.read((uint8_t*)&gestures[i], sizeof(Gesture));
  f.close();
  Serial.printf("[FS] Loaded %d gestures from flash\n", gestureCount);
}

// ================================================================
//  HTML PAGE
// ================================================================
const char PAGE[] PROGMEM = R"rawliteral(
<!DOCTYPE html><html><head>
<meta charset='UTF-8'/><title>HandGPT v4 - S3</title>
<style>
*{box-sizing:border-box;margin:0;padding:0;}
