</div></div>

</div>
<script>
var wsock,curF=1,stored_gestures=[];
var FLBL=['Raw Only','Kalman','Moving Avg','Complementary'];
var contMode=false,contTimer=null,lastSpoken='';

function conn(){
wsock=new WebSocket('ws://'+location.hostname+':81/');
wsock.onopen=function(){el('st').textContent='\u25CF Connected';el('st').className='on';};
wsock.onclose=function(){
  el('st').textContent='\u25CF Disconnected';el('st').className='';
  if(contTimer){clearInterval(contTimer);contTimer=null;}
  setTimeout(conn,2000);
};
wsock.onmessage=function(e){
  var d=JSON.parse(e.data);
  if(d.type==='data')   onData(d);
  if(d.type==='status') el('scount').textContent=d.count;
  if(d.type==='saved')  onSaved(d);
  if(d.type==='match')  onMatch(d);
  if(d.type==='boot')   onBoot(d);
  if(d.type==='info')   el('spiffs-msg').textContent=d.msg;
};
}

function el(id){return document.getElementById(id);}
function send(o){if(wsock&&wsock.readyState===1)wsock.send(JSON.stringify(o));}
function fmt(v){return(v>=0?'+':'')+parseFloat(v).toFixed(1);}

function onBoot(d){
var pb=el('bs-pca'),mb=el('bs-mpu'),wb=el('bs-wifi'),fb=el('bs-spiffs');
pb.textContent='PCA: '+(d.pca?'OK':'FAIL'); pb.className='bitem '+(d.pca?'ok':'fail');
mb.textContent='MPU: '+d.mpuOk+'/6'; mb.className='bitem '+(d.mpuOk===6?'ok':(d.mpuOk>0?'warn':'fail'));
wb.textContent='AP Mode: '+(d.wifi?d.ip:'FAIL'); wb.className='bitem '+(d.wifi?'ok':'fail');
fb.textContent='Flash: '+(d.spiffs?'OK':'FAIL'); fb.className='bitem '+(d.spiffs?'ok':'fail');
for(var i=0;i<6;i++){
  el('sd'+i).className='sdot '+(d.sensors[i]?'':'fail');
}
}

function setF(f){
curF=f;
for(var i=0;i<4;i++) el('f'+i).className='fb'+(i===f?' act':'');
el('fph').textContent=f===0?'--':FLBL[f]+' P';
el('frh').textContent=f===0?'--':FLBL[f]+' R';
send({cmd:'filter',val:f});
}

function onData(d){
for(var i=0;i<6;i++){
  var ok=d.ok[i];
  el('sd'+i).className='sdot'+(ok?'':' fail');
  el('ss'+i).innerHTML=ok?'<span style="color:#3fb950">&#x2713;</span>':'<span style="color:#f85149">&#x2717;</span>';
  el('rp'+i).textContent=ok?fmt(d.rp[i]):'--';
  el('rr'+i).textContent=ok?fmt(d.rr[i]):'--';
  if(curF===0||!ok){
    el('fp'+i).textContent='-'; el('fr'+i).textContent='-';
    el('dp'+i).textContent='-'; el('dp'+i).className='dz';
    el('dr'+i).textContent='-'; el('dr'+i).className='dz';
  } else {
    el('fp'+i).textContent=fmt(d.fp[i]);
    el('fr'+i).textContent=fmt(d.fr[i]);
    setDiff('dp'+i,d.fp[i]-d.rp[i]);
    setDiff('dr'+i,d.fr[i]-d.rr[i]);
  }
}
}

function setDiff(id,v){
var e=el(id);
e.textContent=(v>=0?'+':'')+v.toFixed(1);
e.className=Math.abs(v)<0.5?'dz':(v>0?'dp':'dn');
}

function startRec(){
var lbl=el('glbl').value.trim().toUpperCase();
if(!lbl){el('rec-msg').textContent='Enter a label!';el('rec-msg').style.color='#f85149';return;}
el('bstart').disabled=true; el('bstop').disabled=false;
el('scount').className='rec';
el('rec-msg').textContent='Recording '+lbl+'...'; el('rec-msg').style.color='#d29922';
send({cmd:'startRec',label:lbl});
}

function stopRec(){
el('bstart').disabled=false; el('bstop').disabled=true;
el('scount').className='';
el('rec-msg').textContent='Saving...'; el('rec-msg').style.color='#58a6ff';
send({cmd:'stopRec'});
}

function onSaved(d){
  if(d.label&&d.label!=='EMPTY'){
    el('rec-msg').textContent='Saved: '+d.label+' (vec '+(d.vecIdx+1)+'/'+d.vecCount+', '+d.sampleCount+' samples)';
    el('rec-msg').style.color='#3fb950';
  }
  el('scount').textContent='0';
  stored_gestures=d.gestures||[]; rebuildTable();
  if(d.total!==undefined){
    el('ds-msg').textContent='Dataset updated: '+d.total+' gesture(s)';
    el('ds-msg').style.color='#3fb950';
  }
}

function doCheck(){ send({cmd:'check'}); }

function toggleCont(){
contMode=!contMode;
if(contMode){
  el('btnCont').textContent='\u23F9 Stop Continuous'; el('btnCont').className='btn btn-r';
  el('cont-pill').textContent='CONTINUOUS: ON'; el('cont-pill').className='';
  contTimer=setInterval(function(){send({cmd:'check'});},1000);
  send({cmd:'check'});
} else {
  clearInterval(contTimer); contTimer=null;
  el('btnCont').textContent='\u25B6 Start Continuous'; el('btnCont').className='btn btn-p';
  el('cont-pill').textContent='CONTINUOUS: OFF'; el('cont-pill').className='off';
}
}

function onMatch(d){
el('match-wrap').style.display='';
if(!d.found){
  el('match-name').textContent='No gestures stored';
  el('match-name').style.color='#f85149';
  el('match-rows').innerHTML=''; return;
}
var sorted=d.all.slice().sort(function(a,b){return b.conf-a.conf;});
var best=sorted[0];
var stable=d.stable!==false;
el('match-name').textContent=stable?best.label:'...';
el('match-name').className='match-name'+(stable?'':' pend');
el('match-warn').textContent=d.unreliable?'\u26A0 Some sensors offline':'';
el('match-conf').textContent='Confidence: '+best.conf.toFixed(1)+'%   Dist: '+best.dist.toFixed(2)+(stable?'':' (stabilising...)');
el('match-bar').style.width=Math.min(best.conf,100)+'%';
if(stable&&best.conf>=55&&window.speechSynthesis&&best.label!==lastSpoken){
  lastSpoken=best.label;
  window.speechSynthesis.cancel();
  window.speechSynthesis.speak(new SpeechSynthesisUtterance(best.label));
}
if(best.conf<40) lastSpoken='';
var html='';
sorted.forEach(function(g){
  var isBest=g.label===best.label;
  var bw=Math.min(g.conf,100).toFixed(1)+'%';
  html+='<tr class="'+(isBest?'best-row':'')+'"><td class="glbl">'+g.label+'</td>';
  html+='<td>'+g.vecs+'</td><td>'+g.dist.toFixed(2)+'</td>';
  html+='<td>'+g.conf.toFixed(1)+'%</td>';
  html+='<td class="bar-cell"><div class="mini-bar-w"><div class="mini-bar" style="width:'+bw+'"></div></div></td></tr>';
});
el('match-rows').innerHTML=html;
}

function rebuildTable(){
el('gcnt').textContent='('+stored_gestures.length+')';
if(!stored_gestures.length){
  el('gtb').innerHTML='<tr><td colspan=4 style="color:#484f58;text-align:center;padding:16px">No gestures recorded yet</td></tr>';
  return;
}
var html='';
stored_gestures.forEach(function(g,i){
  html+='<tr><td class="glbl">'+g.label+'</td><td>';
  var vb='<span class="vbar">';
  for(var v=0;v<5;v++) vb+='<span class="vbox'+(v<g.vecCount?' on':'')+'"></span>';
  vb+='</span>';
  html+=vb+' '+g.vecCount+'/5</td>';
  html+='<td>'+g.lastSamples+'</td>';
  html+='<td><button class="del" onclick="delGesture('+i+')">Del</button></td></tr>';
});
el('gtb').innerHTML=html;
}

function delGesture(i){if(!confirm('Delete?'))return;send({cmd:'delete',idx:i});}
function clearAll(){if(!confirm('Clear ALL gestures?'))return;send({cmd:'clearAll'});}

function exportDS(){
if(!stored_gestures.length){alert('No gestures stored to export.');return;}
var b=new Blob([JSON.stringify({version:2,gestures:stored_gestures},null,2)],{type:'application/json'});
var a=document.createElement('a');a.href=URL.createObjectURL(b);a.download='handgpt.json';a.click();
el('ds-msg').textContent='Exported '+stored_gestures.length+' gestures.';el('ds-msg').style.color='#3fb950';
}

function exportCSV(){
if(!stored_gestures.length){alert('No gestures stored to export.');return;}
var rows=['label,vec,samples'];
stored_gestures.forEach(function(g){
  rows.push(g.label+','+g.vecCount+','+g.lastSamples);
});
var b=new Blob([rows.join('\n')],{type:'text/csv'});
var a=document.createElement('a');a.href=URL.createObjectURL(b);a.download='handgpt.csv';a.click();
el('ds-msg').textContent='Exported CSV.';el('ds-msg').style.color='#3fb950';
}

function importDS(evt){
var file=evt.target.files[0];if(!file)return;
var r=new FileReader();
r.onload=function(e){
  try{
    var obj=JSON.parse(e.target.result);
    var arr=obj.gestures||obj;
    if(!Array.isArray(arr)||!arr.length)throw new Error('Empty');
    send({cmd:'loadDataset',gestures:arr});
    el('ds-msg').textContent='Uploading...';el('ds-msg').style.color='#d29922';
  }catch(err){el('ds-msg').textContent='Failed: '+err.message;el('ds-msg').style.color='#f85149';}
  el('imp-file').value='';
};
r.readAsText(file);
}

conn();
</script></body></html>
)rawliteral";

// ================================================================
//  HARDWARE
// ================================================================
void pcaSelect(uint8_t ch){ Wire.beginTransmission(PCA_ADDR);Wire.write(1<<ch);Wire.endTransmission(); }
void pcaDisable(){ Wire.beginTransmission(PCA_ADDR);Wire.write(0);Wire.endTransmission(); }
bool mpuWake(){ Wire.beginTransmission(MPU_ADDR);Wire.write(0x6B);Wire.write(0x00);return Wire.endTransmission()==0; }
bool mpuRead(float &ax,float &ay,float &az){
  Wire.beginTransmission(MPU_ADDR);Wire.write(0x3B);
  if(Wire.endTransmission(false)!=0) return false;
  if(Wire.requestFrom((uint8_t)MPU_ADDR,(uint8_t)6)<6) return false;
  int16_t r[3];
  for(int i=0;i<3;i++) r[i]=(int16_t)((Wire.read()<<8)|Wire.read());
  ax=r[0]/16384.0f;ay=r[1]/16384.0f;az=r[2]/16384.0f;
  return true;
}

void readAndFilter(){
  for(int i=0;i<6;i++){
    pcaSelect(CH[i]); delayMicroseconds(200);
    float ax,ay,az;
    bool ok=mpuRead(ax,ay,az);
    sensorOK[i]=ok;
    if(!ok) continue;
    float p=atan2f(-ax,sqrtf(ay*ay+az*az))*57.2957795f;
    float r=atan2f(ay,az)*57.2957795f;
    rawP[i]=p; rawR[i]=r;
    float kfp=kP[i].update(p),kfr=kR[i].update(r);
    float mfp=mP[i].update(p),mfr=mR[i].update(r);
    float cfp=cP[i].update(p),cfr=cR[i].update(r);
    switch(activeFilter){
      case 1:filP[i]=kfp;filR[i]=kfr;break;
      case 2:filP[i]=mfp;filR[i]=mfr;break;
      case 3:filP[i]=cfp;filR[i]=cfr;break;
      default:filP[i]=p;filR[i]=r;break;
    }
  }
  pcaDisable();
}

void resetFilters(){
  for(int i=0;i<6;i++){ kP[i].reset();kR[i].reset();mP[i].reset();mR[i].reset();cP[i].reset();cR[i].reset(); }
}

// ================================================================
//  GESTURE LOGIC
// ================================================================
void currentFeat(float f[FEAT_DIM]){
  for(int i=0;i<6;i++){
    f[i*2]   = sensorOK[i] ? filP[i] : 0.0f;
    f[i*2+1] = sensorOK[i] ? filR[i] : 0.0f;
  }
}

float euclidean(const float* a,const float* b,int n){
  float s=0; for(int i=0;i<n;i++){float d=a[i]-b[i];s+=d*d;} return sqrtf(s);
}

bool anySensorFailed(){ for(int i=0;i<6;i++) if(!sensorOK[i]) return true; return false; }

bool checkMajority(const char* lbl){
  int c=0; for(int i=0;i<VOTE_WIN;i++) if(strcmp(voteHist[i],lbl)==0) c++; return c>=2;
}

void sendGestureList(const char* lbl, int sc, int vi, int vc = 0){
  String msg="{\"type\":\"saved\",\"label\":\""; msg+=lbl;
  msg+="\",\"sampleCount\":"; msg+=sc;
  msg+=",\"vecIdx\":"; msg+=vi;
  msg+=",\"vecCount\":"; msg+=vc;
  msg+=",\"total\":"; msg+=gestureCount;
  msg+=",\"gestures\":[";
  for(int i=0;i<gestureCount;i++){
    msg+="{\"label\":\""; msg+=gestures[i].label;
    msg+="\",\"vecCount\":"; msg+=gestures[i].vecCount;
    msg+=",\"lastSamples\":"; msg+=gestures[i].lastSamples;
    msg+=",\"means\":[";
    for(int v=0;v<gestures[i].vecCount;v++){
      msg+="[";
      for(int f=0;f<FEAT_DIM;f++){
        msg+=String(gestures[i].vecs[v][f],2);
        if(f<FEAT_DIM-1) msg+=",";
      }
      msg+="]";
      if(v<gestures[i].vecCount-1) msg+=",";
    }
    msg+="]}";
    if(i<gestureCount-1) msg+=",";
  }
  msg+="]}";
  ws.broadcastTXT(msg);
}

void sendMatch(){
  if(gestureCount==0){ ws.broadcastTXT("{\"type\":\"match\",\"found\":false}"); return; }

  float feat[FEAT_DIM];
  currentFeat(feat);

  // Pool all vectors
  struct N { float dist; int gi; };
  N pool[MAX_GESTURES*MAX_VECS];
  int ps=0;
  for(int i=0;i<gestureCount;i++)
    for(int v=0;v<gestures[i].vecCount;v++)
      pool[ps++]={euclidean(feat,gestures[i].vecs[v],FEAT_DIM),i};

  // Partial sort K nearest
  int K=min(KNN_K,ps);
  for(int k=0;k<K;k++){
    int m=k; for(int j=k+1;j<ps;j++) if(pool[j].dist<pool[m].dist) m=j;
    N tmp=pool[k]; pool[k]=pool[m]; pool[m]=tmp;
  }

  // Vote + best dist per gesture
  int   votes[MAX_GESTURES]={};
  float bestD[MAX_GESTURES];
  for(int i=0;i<gestureCount;i++) bestD[i]=1e9f;
  for(int k=0;k<K;k++){
    votes[pool[k].gi]++;
    if(pool[k].dist<bestD[pool[k].gi]) bestD[pool[k].gi]=pool[k].dist;
  }

  // Softmax
  float scores[MAX_GESTURES], scoreSum=0;
  for(int i=0;i<gestureCount;i++){
    scores[i]=expf(-bestD[i]/SOFTMAX_SIGMA); scoreSum+=scores[i];
  }

  // Winner
  int best=0;
  for(int i=1;i<gestureCount;i++)
    if(votes[i]>votes[best]||(votes[i]==votes[best]&&scores[i]>scores[best])) best=i;

  // Majority vote smoothing
  strncpy(voteHist[voteIdx],gestures[best].label,31);
  voteIdx=(voteIdx+1)%VOTE_WIN;
  bool stable=checkMajority(gestures[best].label);

  String msg="{\"type\":\"match\",\"found\":true";
  msg+=",\"stable\":"; msg+=(stable?"true":"false");
  msg+=",\"unreliable\":"; msg+=(anySensorFailed()?"true":"false");
  msg+=",\"all\":[";
  for(int i=0;i<gestureCount;i++){
    float conf=(scoreSum>0.0001f)?100.0f*scores[i]/scoreSum:0.0f;
    msg+="{\"label\":\""; msg+=gestures[i].label;
    msg+="\",\"dist\":";  msg+=String(bestD[i]<1e8f?bestD[i]:0,2);
    msg+=",\"conf\":";    msg+=String(conf,1);
    msg+=",\"vecs\":";    msg+=gestures[i].vecCount;
    msg+=",\"votes\":";   msg+=votes[i];
    msg+="}";
    if(i<gestureCount-1) msg+=",";
  }
  msg+="]}";
  ws.broadcastTXT(msg);
}

// Send boot status to browser once WS connects
void sendBootStatus(){
  String msg="{\"type\":\"boot\"";
  msg+=",\"pca\":"; msg+=(pcaFound?"true":"false");
  msg+=",\"mpuOk\":"; msg+=mpuFoundCnt;
  msg+=",\"wifi\":"; msg+=(wifiOK?"true":"false");
  msg+=",\"ip\":\""; msg+=ipStr; msg+="\"";
  msg+=",\"spiffs\":"; msg+=(fsOK?"true":"false");
  msg+=",\"sensors\":[";
  for(int i=0;i<6;i++){ msg+=(sensorOK[i]?"true":"false"); if(i<5)msg+=","; }
  msg+="]}";
  ws.broadcastTXT(msg);
}

// ================================================================
//  WEBSOCKET
// ================================================================
void wsEvent(uint8_t num, WStype_t type, uint8_t* payload, size_t len){
  if(type==WStype_CONNECTED){ sendBootStatus(); sendGestureList("",0,0,0); return; }
  if(type!=WStype_TEXT) return;
  String s=(char*)payload;

  if(s.indexOf("\"cmd\":\"filter\"")>=0){
    int idx=s.indexOf("\"val\":"); if(idx>=0){int v=s.substring(idx+6).toInt();if(v>=0&&v<=3){activeFilter=v;resetFilters();}}
    return;
  }

  if(s.indexOf("\"cmd\":\"startRec\"")>=0){
    int li=s.indexOf("\"label\":\""); strncpy(recLabel,"UNKNOWN",31);
    if(li>=0){int st=li+9,en=s.indexOf("\"",st);String l=s.substring(st,en);l.toUpperCase();strncpy(recLabel,l.c_str(),31);recLabel[31]=0;}
    recCount=0; recActive=true;
    Serial.printf("[REC] Start: %s\n",recLabel);
    return;
  }

  if(s.indexOf("\"cmd\":\"stopRec\"")>=0){
    recActive=false;
    Serial.printf("[REC] Stop received. Total recCount = %d\n", recCount);
    if(recCount==0){
      Serial.println("[REC] WARNING: recCount is 0! No samples recorded.");
      ws.sendTXT(num,"{\"type\":\"saved\",\"label\":\"EMPTY\",\"sampleCount\":0,\"vecIdx\":0,\"vecCount\":0,\"total\":0,\"gestures\":[]}");
      return;
    }
    float mean[FEAT_DIM]={};
    for(int si=0;si<recCount;si++) for(int f=0;f<FEAT_DIM;f++) mean[f]+=recBuf[si][f];
    for(int f=0;f<FEAT_DIM;f++) mean[f]/=recCount;
    int slot=-1;
    for(int i=0;i<gestureCount;i++) if(strcasecmp(gestures[i].label,recLabel)==0){slot=i;break;}
    if(slot<0){
      if(gestureCount>=MAX_GESTURES){Serial.println("[REC] Full!");return;}
      slot=gestureCount++;
      strncpy(gestures[slot].label,recLabel,31);
      gestures[slot].vecCount=0; gestures[slot].used=true;
    }
    int vi=gestures[slot].vecCount<MAX_VECS?gestures[slot].vecCount:MAX_VECS-1;
    if(gestures[slot].vecCount<MAX_VECS) gestures[slot].vecCount++;
    memcpy(gestures[slot].vecs[vi],mean,sizeof(mean));
    gestures[slot].lastSamples=recCount;
    Serial.printf("[REC] Saved %s vec%d: %d samples\n",recLabel,vi,recCount);
    saveDataset();
    sendGestureList(recLabel,recCount,vi,gestures[slot].vecCount);
    recCount=0; return;
  }

  if(s.indexOf("\"cmd\":\"check\"")>=0){ sendMatch(); return; }

  if(s.indexOf("\"cmd\":\"clearAll\"")>=0){
    gestureCount=0; memset(gestures,0,sizeof(gestures)); saveDataset(); sendGestureList("",0,0,0); return;
  }

  if(s.indexOf("\"cmd\":\"delete\"")>=0){
    int ii=s.indexOf("\"idx\":"); if(ii>=0){
      int idx=s.substring(ii+6).toInt();
      if(idx>=0&&idx<gestureCount){for(int i=idx;i<gestureCount-1;i++) gestures[i]=gestures[i+1];gestureCount--;}
    }
    saveDataset(); sendGestureList("",0,0,0); return;
  }

  if(s.indexOf("\"cmd\":\"loadDataset\"")>=0){
    gestureCount=0;
    int arrStart=s.indexOf("\"gestures\":["); if(arrStart<0) return;
    arrStart+=12; int pos=arrStart;
    while(gestureCount<MAX_GESTURES){
      int ob=s.indexOf("{",pos); if(ob<0) break;
      int li=s.indexOf("\"label\":\"",ob); if(li<0) break;
      int ls=li+9,le=s.indexOf("\"",ls);
      String lbl=s.substring(ls,le); lbl.toUpperCase();
      strncpy(gestures[gestureCount].label,lbl.c_str(),31);
      int vc=s.indexOf("\"vecCount\":",ob);
      int vecCount=(vc>=0&&vc<ob+2000)?s.substring(vc+11).toInt():1;
      if(vecCount<1)vecCount=1; if(vecCount>MAX_VECS)vecCount=MAX_VECS;
      int ms=s.indexOf("\"means\":[[",ob);
      if(ms>=0&&ms<ob+2000){
        ms+=9; gestures[gestureCount].vecCount=0;
        for(int vi=0;vi<vecCount;vi++){
          int me=s.indexOf("]",ms); if(me<0) break;
          String marr=s.substring(ms,me);
          int fi=0,mi2=0;
          while(fi<FEAT_DIM && mi2 < (int)marr.length()){
            int comma=marr.indexOf(',',mi2);
            if(comma<0) comma=marr.length();
            gestures[gestureCount].vecs[vi][fi]=marr.substring(mi2,comma).toFloat();
            fi++; mi2=comma+1;
          }
          gestures[gestureCount].vecCount++;
          ms=me+2;
        }
      }
      gestures[gestureCount].lastSamples=100;
      gestures[gestureCount].used=true;
      gestureCount++;
      pos=s.indexOf("}",ob)+1;
    }
    saveDataset(); sendGestureList("",0,0,0); return;
  }
}

// ================================================================
//  SETUP & LOOP
// ================================================================
void setup(){
  Serial.begin(115200);
  delay(500);
  Serial.println("\n--- HandGPT v4 ESP32-S3 Initialising ---");

  Wire.begin(I2C_SDA, I2C_SCL, 400000);

  // PCA check
  Wire.beginTransmission(PCA_ADDR);
  pcaFound = (Wire.endTransmission() == 0);
  Serial.printf("[I2C] PCA9548A: %s\n", pcaFound ? "FOUND" : "NOT FOUND");

  // MPU check across channels
  mpuFoundCnt = 0;
  for(int i=0;i<6;i++){
    pcaSelect(CH[i]); delayMicroseconds(200);
    bool ok = mpuWake();
    sensorOK[i] = ok;
    if(ok) mpuFoundCnt++;
    Serial.printf("[I2C] CH%d (%s): %s\n", CH[i], NM[i], ok ? "MPU OK" : "FAIL");
  }
  pcaDisable();

  initFS();
  loadDataset();

  // AP setup
  WiFi.mode(WIFI_AP);
  WiFi.softAP(AP_SSID, AP_PASS);
  IPAddress ip = WiFi.softAPIP();
  snprintf(ipStr, sizeof(ipStr), "%d.%d.%d.%d", ip[0],ip[1],ip[2],ip[3]);
  wifiOK = true;
  Serial.printf("[AP]  SSID: %s | IP: %s\n", AP_SSID, ipStr);

  http.on("/", [](){ http.send(200, "text/html", PAGE); });
  http.begin();

  ws.begin();
  ws.onEvent(wsEvent);

  Serial.println("--- System Ready ---");
}

void loop(){
  http.handleClient();
  ws.loop();

  static unsigned long lastSensor = 0;
  if(millis() - lastSensor >= 30){
    lastSensor = millis();
    readAndFilter();

    if(recActive && recCount < MAX_SAMPLES){
      currentFeat(recBuf[recCount]);
      recCount++;
    }

    static unsigned long lastBcast = 0;
    if(millis() - lastBcast >= 100){
      lastBcast = millis();
      String msg = "{\"type\":\"data\"";
      msg += ",\"ok\":[";
      for(int i=0;i<6;i++){ msg += (sensorOK[i]?"true":"false"); if(i<5)msg+=","; }
      msg += "],\"rp\":[";
      for(int i=0;i<6;i++){ msg += String(rawP[i],1); if(i<5)msg+=","; }
      msg += "],\"rr\":[";
      for(int i=0;i<6;i++){ msg += String(rawR[i],1); if(i<5)msg+=","; }
      msg += "],\"fp\":[";
      for(int i=0;i<6;i++){ msg += String(filP[i],1); if(i<5)msg+=","; }
      msg += "],\"fr\":[";
      for(int i=0;i<6;i++){ msg += String(filR[i],1); if(i<5)msg+=","; }
      msg += "]}";
      ws.broadcastTXT(msg);
    }
  }
}
