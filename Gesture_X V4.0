.bar-cell{width:120px;}
.mini-bar-w{background:#21262d;border-radius:3px;height:5px;}
.mini-bar{height:100%;background:#3fb950;border-radius:3px;transition:width .4s;}
#cont-pill{display:inline-block;padding:3px 10px;border-radius:10px;font-size:11px;font-weight:700;background:#1a2e1a;color:#3fb950;border:1px solid #3fb950;margin-left:10px;}
#cont-pill.off{background:#0d1117;color:#484f58;border-color:#30363d;}
