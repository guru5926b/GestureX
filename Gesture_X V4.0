.rrow{display:flex;gap:8px;align-items:center;flex-wrap:wrap;margin-bottom:10px;}
input[type=text]{background:#0d1117;border:1px solid #30363d;border-radius:6px;color:#c9d1d9;padding:7px 12px;font-size:13px;outline:none;min-width:180px;}
input:focus{border-color:#58a6ff;}
.btn{border:none;border-radius:6px;padding:8px 16px;font-size:13px;font-weight:700;cursor:pointer;}
.btn-g{background:#3fb950;color:#000;}
.btn-r{background:#f85149;color:#fff;}
.btn-y{background:#d29922;color:#000;}
.btn-b{background:#58a6ff;color:#000;}
.btn-p{background:#bc8cff;color:#000;}
.btn:disabled{opacity:.4;cursor:not-allowed;}
.del{background:#f85149;color:#fff;border:none;border-radius:4px;padding:3px 9px;font-size:11px;font-weight:600;cursor:pointer;}
#scount{font-size:24px;font-weight:900;color:#d29922;font-family:monospace;}
#scount.rec{animation:pulse 1s infinite;}
@keyframes pulse{0%,100%{opacity:1;}50%{opacity:.4;}}
.match-box{background:#0d1117;border:1px solid #21262d;border-radius:8px;padding:14px 18px;display:flex;gap:16px;flex-wrap:wrap;align-items:center;margin-bottom:10px;}
.match-name{font-size:32px;font-weight:900;color:#3fb950;letter-spacing:2px;}
.match-name.pend{color:#d29922;}
.bar-w{flex:1;min-width:120px;background:#21262d;border-radius:4px;height:8px;}
